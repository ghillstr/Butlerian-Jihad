# The one shared secret that gates entry to the app for the whole friend group.
APP_ACCESS_CODE=change-me

# Random string, 32+ characters, used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Server-side only - never exposed to the browser.
ANTHROPIC_API_KEY=

# GMT Games' BoardGameGeek publisher id. Defaults to 52 if unset.
GMT_BGG_PUBLISHER_ID=52

# BoardGameGeek requires a registered application + Authorization Bearer token
# for XML API access. Register at https://boardgamegeek.com/applications, then
# create a token under "Tokens" for your application.
BGG_API_TOKEN=

# Path to the SQLite database file. Must be on a persistent volume in production.
DATABASE_PATH=./data/app.db
